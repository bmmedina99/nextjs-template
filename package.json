{
  "name": "nextkit",
  "description": "Plantilla de inicio para proyectos con Next.js App Router, preconfigurada con TypeScript y TailwindCSS.",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 4000",
    "build": "next build",
    "start": "next start --port 5000",
    "fmt": "pnpm biome format --write .",
    "lint": "pnpm biome lint --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmmedina99/nextkit.git"
  },
  "bugs": {
    "url": "https://github.com/bmmedina99/nextkit/issues"
  },
  "dependencies": {
    "next": "15.5.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.6.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.18.0"
}
